{
  "name": "dsh-collab-journal",
  "version": "0.2.0",
  "description": "DSH 原生协作观察插件：按 workspace 浏览会话，手动简化人机轨迹，回查原文。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "docs/philosophy.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tonexue1/ai-collab-journal.git"
  },
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.2-rc.1 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "test": "node --test test/*.test.mjs",
    "test:integration": "node test/dsh.integration.mjs",
    "test:browser": "node test/dsh.browser.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.1.0",
    "@deepseek-ai/dsh-llm": "0.2.2-rc.1",
    "@deepseek-ai/dsh-storage-domain": "0.2.2-rc.1",
    "react": "^18.3.1"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "dependencies": {
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "esbuild": "^0.27.4",
    "react": "^18.3.1"
  }
}
